# vCraft Environment Configuration
NODE_ENV=development
# Use 0.0.0.0 in Docker/PaaS; keep 127.0.0.1 for local dev or same-machine Cloudflare Tunnel.
HOST=127.0.0.1
PORT=5000
# False locally, loopback for same-machine Cloudflare Tunnel/Nginx, or 1 for Render/Railway/Fly.io single proxy hop; never true.
TRUST_PROXY=false
# Comma-separated browser origins; use actual frontend URLs when deployed.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5189,http://localhost:5189

# PostgreSQL 18 Connection (Local or Docker)
DATABASE_URL=postgresql://vcraft_app:APP_PASSWORD@localhost:5432/vcraft_nhaxa_dev?schema=public
MIGRATION_DATABASE_URL=postgresql://vcraft_migrator:MIGRATOR_PASSWORD@localhost:5432/vcraft_nhaxa_dev?schema=public

# Optional Redis Cache (not required by the current backend)
REDIS_URL=redis://localhost:6379

# Security & Authentication
JWT_SECRET=CHANGE_ME_use_a_random_secret_at_least_32_bytes
# Set true to audit the storefront CSP in the browser before enforcing it.
SITE_CSP_REPORT_ONLY=false
# Password recovery email. Set all three to enable recovery.
PUBLIC_APP_URL=
PASSWORD_RESET_FROM=
RESEND_API_KEY=

# QR Code Base URL
QR_BASE_URL=http://127.0.0.1:5000/trace
# Persistent storage for optimized uploads.
UPLOAD_DIR=storage/uploads

# Nha Xa development seed. Set a password of 12 to 72 UTF-8 bytes.
SEED_DEMO_PASSWORD=

# Optional Docker PostgreSQL. Use port 5433 in both connection URLs with Docker.
POSTGRES_PORT=5433
POSTGRES_PASSWORD=vcraft_local_dev_only
