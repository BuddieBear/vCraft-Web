# vCraft Environment Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL 15 Connection (Local or Docker)
DATABASE_URL="postgresql://vcraft_app:APP_PASSWORD@localhost:5432/vcraft_nhaxa_dev?schema=public"
MIGRATION_DATABASE_URL="postgresql://vcraft_migrator:MIGRATOR_PASSWORD@localhost:5432/vcraft_nhaxa_dev?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="vcraft_super_secret_jwt_key_2026_vanphuc_silk"
JWT_EXPIRES_IN="7d"

# QR Code Base URL
QR_BASE_URL="http://localhost:5173/trace"

# Nha Xa development seed. Set a password of 12 to 72 UTF-8 bytes.
SEED_DEMO_PASSWORD=

# Optional Docker PostgreSQL. Use port 5433 in both connection URLs with Docker.
POSTGRES_PORT=5433
POSTGRES_PASSWORD=vcraft_local_dev_only
